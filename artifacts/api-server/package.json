{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:schedule": "vitest run --config vitest.config.ts",
    "test:auth": "tsx --test src/auth/auth.test.ts",
    "test:email": "tsx --test src/email.test.ts",
    "test:onboarding": "tsx --test src/onboarding.test.ts",
    "test:volunteer": "tsx --test src/volunteer.test.ts",
    "test:roster": "tsx --test src/admin-roster.test.ts",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "coverage-digest": "tsx src/server/runCoverageDigest.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.1.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "postmark": "^5.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "vitest": "^5.0.3"
  }
}
