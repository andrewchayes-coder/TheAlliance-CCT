modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "cloudrun"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.production]
APP_ORIGIN = "https://the-alliance-cct.replit.app"
RUN_JOBS = "false"
JOBS_RUN_URL = "https://the-alliance-cct.replit.app/api/jobs/run"
APP_BASE_URL = "https://the-alliance-cct.replit.app"

[userenv.development]
